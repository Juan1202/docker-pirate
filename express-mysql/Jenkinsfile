pipeline {
    agent any

    tools {
        nodejs 'nodejs' 
    }

    environment {
        PROJECT_ROOT = 'express-mysql/app'
        REGISTRY = 'juan1202/docker-pirate-express'
        SONAR_CRED_ID = 'sonar-token'
        DOCKER_CRED_ID = 'dockerhub-creds'
    }

    stages {
        stage('Initialize') {
            steps {
                echo "Limpiando y preparando entorno..."
                sh "rm -f zap_report.html"
                sh "mkdir -p dependency-check-reports"
                // Permisos drásticos para asegurar la escritura de Docker
                sh "chmod -R 777 ."
            }
        }
        
        // ... (Stages de Checkout, Install, Tests y Sonar se mantienen igual) ...

        stage('OWASP ZAP Scan (DAST)') {
            steps {
                script {
                    echo "Levantando contenedor temporal..."
                    sh "docker run -d --name zap-test-app -p 3001:3000 ${REGISTRY}:${BUILD_NUMBER}"
                    
                    sleep 20 
                    
                    try {
                        def appIp = sh(script: "docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' zap-test-app", returnStdout: true).trim()
                        
                        // IMPORTANTE: Mapeamos el workspace actual $(pwd) al directorio /zap/wrk/ dentro del contenedor
                        sh """
                            docker run --rm --name zap-container \
                            -u root \
                            -v \$(pwd):/zap/wrk/:rw \
                            owasp/zap2docker-stable zap-baseline.py \
                            -t http://${appIp}:3000 \
                            -r zap_report.html
                        """
                    } catch (Exception e) {
                        echo "ZAP finalizó el escaneo."
                    } finally {
                        sh "docker stop zap-test-app && docker rm zap-test-app"
                        
                        // Forzamos que el archivo tenga permisos de lectura para Jenkins
                        sh "chmod 644 zap_report.html || true"
                        
                        publishHTML([
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: '.', // Busca en la raíz del workspace
                            reportFiles: 'zap_report.html',
                            reportName: 'OWASP ZAP Report'
                        ])
                    }
                }
            }
        }
        
        // ... (Stage de Deploy se mantiene igual) ...
    }
}